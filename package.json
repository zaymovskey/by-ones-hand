{
  "name": "by-ones-hand",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:electron": "npm run build && electron tests/smoke.cjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/main.cjs",
  "productName": "By One's Hand",
  "description": "By One's Hand desktop game starter",
  "author": "By One's Hand",
  "build": {
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis"
    },
    "appId": "com.byoneshand.game",
    "productName": "By One's Hand",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ]
  }
}
